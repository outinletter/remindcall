            "state": "translated",
            "value": "为此号码添加标签"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label This Number"
          }
        }
      }
    },
    "이름 옆 즐겨찾기 별": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の横によく使う項目の星"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "姓名旁显示个人收藏星标"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite Star Next to Name"
          }
        }
      }
    },
    "이름, 번호 뒷자리, 초성": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前、番号の下桁"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "姓名、号码后几位"
          }
        },
        "en": {
          "stringUnit": {
