        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "설정에서 RemindCall의 알림을 허용한 뒤 다시 켜 주세요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でRemindCallの通知を許可してから、もう一度オンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中允许RemindCall的通知后再开启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications for RemindCall in Settings, then turn this on again."
          }
        }
      }
    },
    "설정에서 RemindCall의 연락처 접근을 허용해 주세요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でRemindCallの連絡先へのアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中允许RemindCall访问通讯录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow RemindCall to access Contacts in Settings."
          }
        }
      }
    },
    "수신 전화": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来电"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming Calls"
          }
        }
      }
    },
    "숨김": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden"
          }
        }
      }
    },
    "시스템 전화 앱의 통화 기록은 iOS 정책상 볼 수 없어, RemindCall에서 건 통화만 표시됩니다.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの方針により電話アプリの通話履歴は読み取れないため、RemindCallから発信した通話のみ表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据iOS政策无法读取系统电话App的通话记录，因此仅显示从RemindCall拨出的电话。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS doesn't allow apps to read the Phone app's call history, so only calls made from RemindCall are shown."
          }
        }
      }
    },
    "아래 메모 버튼으로 첫 메모를 남겨 보세요": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のメモボタンで最初のメモを残しましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用下方的备忘录按钮留下第一条备忘录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first note with the Note button below"
          }
        }
      }
    },
    "아직 연락 기록 없음": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ連絡記録なし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无联系记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contact history yet"
          }
        }
      }
    },
    "알림": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        },
        "zh-Hans": {
