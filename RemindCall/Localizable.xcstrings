    "설정 열기": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
