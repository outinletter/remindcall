    "국내 번호는 010-1234-5678처럼, 해외 번호는 +국가번호로 입력하세요.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国内番号はそのまま、海外番号は+国番号から入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国内号码直接输入，国外号码请以+国家代码开头输入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter local numbers as usual, or international numbers starting with + and the country code."
          }
        }
      }
    },
